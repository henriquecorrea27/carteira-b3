# Copy to backend/.env and fill in. Never commit the real .env.
POSTGRES_SUPERUSER_PASSWORD=
DATABASE_URL=postgresql+psycopg://carteira:CHANGE_ME@localhost:5432/carteira
DATABASE_URL_TEST=postgresql+psycopg://carteira:CHANGE_ME@localhost:5432/carteira_test
# Discord: canal > Editar canal > Integrações > Webhooks > Copiar URL do webhook
DISCORD_WEBHOOK_URL=
# Lista de observação (preço x MM200) em outro canal; vazio = mesmo canal do relatório diário
DISCORD_WATCHLIST_WEBHOOK_URL=
# Horário do relatório diário (dias úteis da B3, horário de Brasília)
REPORT_TIME=19:00
